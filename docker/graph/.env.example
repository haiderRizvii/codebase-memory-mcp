# Copy to .env (same folder) and set a password. .env is git-ignored.
# Every container of compose.yaml loads it (a NEO4J_PASSWORD in your shell or
# Windows environment is ignored): the Neo4j container
# is created with this password and the indexer / MCP server log in with it.
NEO4J_PASSWORD=change-me-to-a-long-random-password

# Optional
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
# NEO4J_HEAP=2g
# NEO4J_PAGECACHE=1g

# Host folders holding the data (bind-mounted; relative paths are relative to
# this folder). Neo4j's store and the indexer cache belong together: the MCP
# server needs both, so keep, back up and move them as a pair.
# CBM_NEO4J_DATA_DIR=/srv/cbm/neo4j
# CBM_NEO4J_LOGS_DIR=/srv/cbm/neo4j-logs
# CBM_DATA_DIR=/srv/cbm/cache
